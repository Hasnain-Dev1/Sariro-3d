// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* Legacy models (kept for backward compat with any local sqlite tooling) */
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ════════════════════════════════════════════════════════════════
   SARIRO — Batch Management System (v1.0)
   
   NOTE: The production database is Supabase (Postgres). This Prisma
   schema is kept in sync for local tooling, introspection, and type
   generation. The actual tables live in Supabase and are managed via
   SQL migrations (see scripts/migration.sql). Do NOT run prisma
   migrate against production — use Supabase SQL Editor instead.
   
   Tables (mirror the Supabase schema exactly):
   - profiles (extended with role, timezone, track, current_cohort_id)
   - cohorts
   - enrollments
   - bookings
   - purchase_intents
   - admin_audit_logs
   ════════════════════════════════════════════════════════════════ */

model Profile {
  id                String   @id @default(uuid())
  email             String?  @unique
  full_name         String?
  phone             String?
  avatar_url        String?
  provider          String?
  role              String?  // 'student' | 'teacher' | 'admin' | 'super_admin'
  email_verified    Boolean  @default(false)
  phone_verified    Boolean  @default(false)
  profile_completed Boolean  @default(false)
  // Legacy role booleans (kept for backfill fallback)
  is_student        Boolean  @default(false)
  is_teacher        Boolean  @default(false)
  is_admin          Boolean  @default(false)
  is_super_admin    Boolean  @default(false)
  // New v1.0 columns
  timezone          String?
  track             String?
  current_cohort_id String?
  is_parent         Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  enrollments       Enrollment[]
  purchaseIntents   PurchaseIntent[]
  bookingsTeacher   Booking[]       @relation("BookingTeacher")
  auditLogs         AdminAuditLog[]
  submissions       ProjectSubmission[]  @relation("UserSubmissions")
  feedbackGiven     SubmissionFeedback[] @relation("TeacherFeedback")
  reviewedSubmissions ProjectSubmission[] @relation("ReviewerOfSubmissions")

  @@map("profiles")
}

model Cohort {
  id              String   @id @default(uuid())
  batch_code      String?  @unique // human-readable batch id, e.g. "B-0001"
  track           String
  level           String   // 'beginner' | 'intermediate' | 'advanced'
  ratio           String   // '1:1' | '1:4'
  status          String   @default("gathering") // gathering | ready | active | completed
  max_capacity    Int      @default(4)
  google_meet_url String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  activated_at    DateTime?
  completed_at    DateTime?

  enrollments     Enrollment[]
  bookings        Booking[]

  @@map("cohorts")
}

model Enrollment {
  id                  String   @id @default(uuid())
  user_id             String
  track               String
  level               String
  ratio               String
  status              String   @default("pending") // pending | active | completed | dropped
  cohort_id           String?
  started_at          DateTime?
  completed_at        DateTime?
  completion_shown_at DateTime? // NULL = upsell popup still pending
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user                Profile  @relation(fields: [user_id], references: [id])
  cohort              Cohort?  @relation(fields: [cohort_id], references: [id])
  submissions         ProjectSubmission[]

  @@index([user_id])
  @@index([cohort_id])
  @@index([status])
  @@index([track, level])
  @@map("enrollments")
}

model Booking {
  id              String   @id @default(uuid())
  cohort_id       String
  teacher_id      String
  slot_start      DateTime
  slot_end        DateTime
  status          String   @default("scheduled") // scheduled | completed | cancelled | no_show
  google_meet_url String?
  // Capstone system: which lesson this session teaches (nullable for review/Q&A)
  module_num      Int?
  lesson_name     String?
  // Reschedule / cancel / pay bookkeeping (policy engine)
  reschedule_initiator String?  // 'student' | 'teacher' | 'admin'
  rescheduled_from     DateTime?
  reschedule_count     Int      @default(0)
  rescheduled_by       String?
  rescheduled_at       DateTime?
  cancel_actor_role    String?  // 'student' | 'teacher' | 'admin' | 'hr' | 'system'
  cancelled_by         String?  // uuid of the user who cancelled (pre-existing column)
  cancelled_at         DateTime?
  cancel_reason        String?
  cancel_type          String?  // 'student_1to1' | 'teacher_leave' | 'doubt_session' | 'group_blocked' | 'admin'
  pay_status           String?  // 'full' | 'partial' | 'zero'
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  cohort          Cohort   @relation(fields: [cohort_id], references: [id])
  teacher         Profile  @relation("BookingTeacher", fields: [teacher_id], references: [id])
  submissions     ProjectSubmission[]

  @@index([cohort_id])
  @@index([teacher_id])
  @@index([slot_start])
  @@index([status])
  @@map("bookings")
}

model PurchaseIntent {
  id            String   @id @default(uuid())
  user_id       String
  track         String
  level         String
  ratio         String
  razorpay_link String?
  status        String   @default("pending") // pending | confirmed | expired
  created_at    DateTime @default(now())
  confirmed_at  DateTime?

  user          Profile  @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@map("purchase_intents")
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  admin_id    String
  action      String
  target_type String?
  target_id   String?
  metadata    Json?
  created_at  DateTime @default(now())

  admin       Profile  @relation(fields: [admin_id], references: [id])

  @@index([admin_id])
  @@index([created_at])
  @@map("admin_audit_logs")
}

/* ════════════════════════════════════════════════════════════════
   Capstone System (Phase 2) — project submissions + feedback
   ════════════════════════════════════════════════════════════════ */

model ProjectSubmission {
  id                  String   @id @default(uuid())
  enrollment_id       String
  booking_id          String?
  user_id             String
  module_num          Int
  lesson_name         String
  capstone_step_title String
  title               String
  description         String?
  project_url         String
  demo_url            String?
  reflection_tricky   String?
  reflection_proud    String?
  status              String   @default("submitted") // submitted | approved | resubmit
  submitted_at        DateTime @default(now())
  reviewed_at         DateTime?
  reviewed_by         String?
  speed_points        Int      @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  enrollment          Enrollment @relation(fields: [enrollment_id], references: [id])
  booking             Booking?   @relation(fields: [booking_id], references: [id])
  user                Profile    @relation("UserSubmissions", fields: [user_id], references: [id])
  reviewer            Profile?   @relation("ReviewerOfSubmissions", fields: [reviewed_by], references: [id])
  feedback            SubmissionFeedback?

  @@unique([enrollment_id, module_num])
  @@index([user_id, submitted_at])
  @@index([enrollment_id, module_num])
  @@index([status])
  @@index([booking_id])
  @@map("project_submissions")
}

model SubmissionFeedback {
  id              String   @id @default(uuid())
  submission_id   String   @unique
  teacher_id      String
  rating          Int
  content         String
  approved        Boolean  @default(true)
  review_points   Int      @default(0)
  ontime_bonus    Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  submission      ProjectSubmission @relation(fields: [submission_id], references: [id])
  teacher         Profile           @relation("TeacherFeedback", fields: [teacher_id], references: [id])

  @@index([teacher_id, created_at])
  @@map("submission_feedback")
}

/* ════════════════════════════════════════════════════════════════
   Per-day schedule times — one start time per weekday of a schedule.
   (Child of cohort_schedules, which lives in Supabase only.)
   ════════════════════════════════════════════════════════════════ */

model CohortScheduleDay {
  id           String   @id @default(uuid())
  schedule_id  String
  day_of_week  Int      // 0=Sun .. 6=Sat
  time_local   String   // 'HH:MM'
  duration_min Int?     // null = inherit schedule default
  created_at   DateTime @default(now())

  @@unique([schedule_id, day_of_week])
  @@index([schedule_id])
  @@map("cohort_schedule_days")
}

/* ════════════════════════════════════════════════════════════════
   Lesson content pages — per-course templates (one page per lesson).
   ════════════════════════════════════════════════════════════════ */

model LessonPage {
  id           String   @id @default(uuid())
  course_id    String
  module_num   Int
  lesson_index Int
  lesson_name  String
  title        String?
  html_content String   @default("")
  published    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([course_id, module_num, lesson_index])
  @@index([course_id])
  @@map("lesson_pages")
}

/* ════════════════════════════════════════════════════════════════
   Class-operations policy: parent eligibility, doubt sessions, support chat.
   (Tables live in Supabase; mirrored here for tooling parity.)
   ════════════════════════════════════════════════════════════════ */

model ParentCourseAssignment {
  id          String   @id @default(uuid())
  parent_id   String
  track       String
  level       String
  assigned_by String?
  created_at  DateTime @default(now())

  @@unique([parent_id, track, level])
  @@index([parent_id])
  @@map("parent_course_assignments")
}

model DoubtSession {
  id             String    @id @default(uuid())
  cohort_id      String?
  booking_id     String?
  teacher_id     String
  requested_by   String?
  status         String    @default("requested") // requested|hr_approved|rejected|conducted|cancelled
  hr_approved_by String?
  hr_approved_at DateTime?
  conducted_at   DateTime?
  notes          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([teacher_id])
  @@index([status])
  @@map("doubt_sessions")
}

model SupportQuery {
  id                String   @id @default(uuid())
  student_id        String
  assigned_admin_id String?
  cohort_id         String?
  subject           String
  status            String   @default("open") // open|pending|resolved|closed
  last_message_at   DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  messages          SupportMessage[]

  @@index([student_id])
  @@index([assigned_admin_id])
  @@index([status])
  @@map("support_queries")
}

model SupportMessage {
  id         String   @id @default(uuid())
  query_id   String
  sender_id  String
  body       String
  created_at DateTime @default(now())

  query      SupportQuery @relation(fields: [query_id], references: [id])

  @@index([query_id, created_at])
  @@map("support_messages")
}

/* ════════════════════════════════════════════════════════════════
   Demo Class Requests — public form for visitors to book a free demo
   ════════════════════════════════════════════════════════════════ */

model DemoClassRequest {
  id                  String   @id @default(uuid())
  student_name        String
  parent_name         String?
  phone               String
  phone_country_code  String?
  email               String?
  course_interest     String?
  preferred_slot      String
  preferred_slot_label String
  timezone            String
  timezone_offset     Int?
  user_agent          String?
  referrer            String?
  status              String   @default("new")
  contacted_at        DateTime?
  scheduled_at        DateTime?
  notes               String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([created_at])
  @@index([status, created_at])
  @@map("demo_class_requests")
}